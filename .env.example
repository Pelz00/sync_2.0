# ─── Supabase ────────────────────────────────────────────────────────────
# Get these from https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — NEVER prefix with NEXT_PUBLIC_. Only used in trusted server code
# (Server Actions, Route Handlers). Bypasses RLS; treat as a master credential.
SUPABASE_SERVER_ROLE_KEY=

# ─── Paystack ────────────────────────────────────────────────────────────
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
# Optional — if Paystack uses a separate secret for webhook signatures
PAYSTACK_WEBHOOK_SECRET=

# ─── Identity verification (Smile ID or Dojah — pick one) ────────────────
VERIFICATION_PROVIDER=             # "smile_id" | "dojah"
VERIFICATION_API_KEY=
VERIFICATION_WEBHOOK_SECRET=

# ─── Upstash Redis (rate limiting) ───────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Site ────────────────────────────────────────────────────────────────
# Public origin used in metadata / canonical URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
